# Runtime application connection. Use the pooled Neon URL for API traffic.
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Use `postgres` for the VPS PostgreSQL container; leave as `neon` for Vercel/Neon.
AUREUM_DATABASE_DRIVER=neon
AUREUM_DATABASE_POOL_SIZE=10

# Pin this deployment to its existing city workspace's legacy_id.
# A missing/inactive workspace stops startup rather than selecting another city.
AUREUM_WORKSPACE_ID=workspace_default

# Direct Neon URL for migrations only.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

PORT=4173
NODE_ENV=development
AUREUM_SESSION_SECRET=replace-with-a-long-random-secret
AUREUM_FRONTEND_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
OUTBOX_BATCH_SIZE=25

# Reliability defaults. Apply migration 010 before deploying with Neon.
AUREUM_DATABASE_TIMEOUT_MS=10000
AUREUM_API_DEADLINE_MS=18000
AUREUM_MAX_ACTIVE_REQUESTS=40
AUREUM_RATE_LOGIN_PER_MINUTE=30
AUREUM_RATE_READ_PER_MINUTE=300
AUREUM_RATE_WRITE_PER_MINUTE=60
AUREUM_RATE_BULK_PER_MINUTE=10
AUREUM_RATE_WEBHOOK_PER_MINUTE=120
